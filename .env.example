# Salin berkas ini menjadi .env.local lalu isi nilainya.
# Jangan pernah meng-commit .env.local — isinya kredensial sungguhan.

# Sambungan PostgreSQL.
# Contoh di bawah berbentuk Neon; basis data PostgreSQL mana pun bisa dipakai.
DATABASE_URL="postgresql://pengguna:sandi@host.neon.tech/namadb?sslmode=require"

# Kunci penanda tangan cookie sesi (HMAC-SHA256).
# WAJIB diisi di produksi. Tanpa ini aplikasi tetap jalan memakai nilai
# cadangan yang tertulis di dalam kode, sehingga cookie sesinya bisa
# dipalsukan siapa pun yang membaca repositori ini.
# Menghasilkan nilai acak:  node -e "console.log(crypto.randomBytes(32).toString('base64url'))"
AUTH_SECRET=""
