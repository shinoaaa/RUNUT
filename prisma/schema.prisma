// ============================================================
// RUNUT — skema basis data
//
// Empat lapis, bukan dua:
//   MASTER    -> boleh disunting, dihapus halus saja (aktif: boolean)
//   REFERENSI -> berversi waktu, yang lama tetap disimpan
//   TRANSAKSI -> hasil olahan, boleh dihitung ulang
//   BUKTI     -> HANYA-TAMBAH. Tidak pernah di-update, tidak pernah dihapus
//
// Arah turunannya sengaja terbalik dari kebiasaan:
// baris Penjemputan DITURUNKAN dari KejadianAlat, bukan sebaliknya.
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------------
// ENUM
// ------------------------------------------------------------

enum Peran {
  PETUGAS
  OPERATOR
  PEMDA
  ADMIN
}

enum SumberData {
  OSM
  IMPOR_DINAS
  PETUGAS
}

enum StatusVerifikasi {
  BELUM
  DIKUNJUNGI
  TUTUP_PERMANEN
  MENOLAK
}

enum KelasSkala {
  KECIL
  SEDANG
  BESAR
}

enum JenisKejadian {
  PICKUP
  TARE
  DROPOFF
  STATUS
  ATTEST
}

enum StatusTrip {
  BERJALAN
  DISETOR
  DITINJAU
}

enum StatusLot {
  TERBUKA
  TERTUTUP
  DISERAHKAN
}

enum HasilKunjungan {
  SELESAI
  TUTUP
  TIDAK_ADA_ORANG
  MENOLAK
}

enum StatusPermintaan {
  BARU
  DIJADWALKAN
  SELESAI
  BATAL
}

/// Bagaimana bobot sebuah penjemputan disetujui pemiliknya.
///
/// Sengaja bukan boolean. Boolean hanya menjawab "disetujui atau tidak",
/// padahal yang berguna bagi pengawas justru pertanyaan berikutnya:
/// kalau tidak, kenapa. Penjemputan yang pemiliknya tidak dapat membuka
/// kode tetap boleh berjalan — jelantahnya nyata dan petugasnya sudah
/// datang — tetapi tidak boleh menyamar sebagai penjemputan yang disetujui.
enum CaraKonfirmasi {
  /// Pemilik membuka halaman warungnya sendiri dan menyebutkan kode yang
  /// diterbitkan server. Satu-satunya cara yang membuktikan ia menyetujui.
  KODE_PEMILIK

  /// Pemilik tidak dapat membuka kodenya. Dicatat apa adanya berikut
  /// alasannya, lalu ditandai di dasbor, di halaman telusur, dan di
  /// halaman pemilik warung itu sendiri.
  TANPA_KODE
}

/// Kenapa sebuah penjemputan berjalan tanpa kode pemilik.
///
/// Persoalannya BUKAN kehadiran. Jelantah disimpan di warung, jadi selalu
/// ada orang yang menyerahkannya — kalau tidak ada, tidak ada yang bisa
/// dijemput. Yang jadi soal adalah siapa yang dapat membuka halaman
/// warung: pemiliknya bisa jadi tidak berponsel pintar, ponselnya mati,
/// kartunya hilang, atau yang menyerahkan memang karyawan sementara
/// pemiliknya di tempat lain.
///
/// Alasan ini ikut MASUK KE MUATAN YANG DITANDATANGANI ALAT, bukan
/// ditulis belakangan lewat papan ketik. Dengan begitu ia tidak dapat
/// diubah setelah kejadian, dan pemilik warung membacanya sendiri di
/// halamannya — sehingga alasan yang mengada-ada dapat ia bantah.
enum AlasanTanpaKode {
  /// Pemilik tidak punya ponsel yang dapat memindai atau membuka halaman.
  TIDAK_PUNYA_PONSEL

  /// Ponselnya ada, tetapi mati, kehabisan daya, atau tidak ada sinyal.
  PONSEL_TIDAK_SIAP

  /// Kartu QR pemilik hilang atau tertinggal.
  KARTU_HILANG

  /// Yang menyerahkan jelantah karyawan; pemiliknya sedang di tempat lain.
  DIWAKILKAN_KARYAWAN

  /// Sebab lain, wajib disertai keterangan tertulis.
  LAINNYA
}

// ------------------------------------------------------------
// LAPIS 1 — MASTER
// ------------------------------------------------------------

model Kecamatan {
  id          Int      @id @default(autoincrement())
  nama        String   @unique
  kodePos     String?
  jumlahDesa  Int      @default(0)
  // Geometri TIDAK disimpan di sini. Poligonnya dilayani sebagai
  // berkas statis di /data/kecamatan.geojson lalu digabungkan
  // di sisi klien berdasarkan nama.
  warung      Warung[]
  titikKumpul TitikKumpul[]

  @@map("kecamatan")
}

model Warung {
  id       Int    @id @default(autoincrement())
  nama     String
  kategori String // hasil pemetaan dari amenity + cuisine + kata pada nama
  cuisine  String?
  alamat   String?
  desa     String?

  lat Float
  lon Float

  kecamatanId Int?
  kecamatan   Kecamatan? @relation(fields: [kecamatanId], references: [id])

  /// Stiker QR yang DITEMPEL di warung. Dipindai petugas sebelum
  /// menimbang, dan gunanya cuma satu: memastikan bobot tercatat ke
  /// warung yang benar. Ia sengaja tidak membuka halaman apa pun.
  qrToken String @unique

  /// Kartu QR yang DIPEGANG PEMILIK. Ini yang membuka /w/ — riwayat,
  /// pendapatan, dan kode konfirmasi yang sedang berjalan.
  ///
  /// Wajib berbeda dari `qrToken`, dan itu bukan kerapian belaka.
  /// Petugas memindai stiker tembok setiap kali menjemput, jadi ia
  /// otomatis memegang token itu untuk tiap warung yang pernah ia
  /// datangi. Kalau keduanya sama, petugas tinggal membuka halaman
  /// pemilik di ponselnya sendiri, membaca kodenya, lalu mengetiknya —
  /// dan konfirmasi pemilik kembali jadi hiasan.
  ///
  /// Sengaja tidak diturunkan dari `qrToken` lewat hash. Kalau
  /// diturunkan, mengganti token pemilik yang kartunya hilang akan ikut
  /// mengubah isi stiker temboknya, sehingga stikernya harus dicetak
  /// dan ditempel ulang padahal yang hilang cuma kartunya.
  tokenPemilik String @unique

  kelasSkala      KelasSkala @default(KECIL)
  estimasiLMinggu Float      @default(0)

  // Dua kolom yang membedakan "tidak pernah setor" dari "sudah tutup".
  sumberData       SumberData       @default(OSM)
  statusVerifikasi StatusVerifikasi @default(BELUM)
  aktif            Boolean          @default(true)

  osmType String?
  osmId   BigInt?

  penjemputan Penjemputan[]
  permintaan  PermintaanJemput[]
  kunjungan   Kunjungan[]
  sesi        SesiKonfirmasi[]

  dibuatAt    DateTime @default(now())
  diperbaruiAt DateTime @updatedAt

  @@index([kecamatanId])
  @@index([statusVerifikasi])
  @@map("warung")
}

model TitikKumpul {
  id          Int        @id @default(autoincrement())
  nama        String
  lat         Float
  lon         Float
  kecamatanId Int?
  kecamatan   Kecamatan? @relation(fields: [kecamatanId], references: [id])
  aktif       Boolean    @default(true)

  trip Trip[]
  lot  Lot[]

  @@map("titik_kumpul")
}

model Pengguna {
  id        Int      @id @default(autoincrement())
  nama      String
  email     String   @unique
  sandiHash String
  peran     Peran
  aktif     Boolean  @default(true)
  dibuatAt  DateTime @default(now())

  perangkat   Perangkat[]
  penjemputan Penjemputan[]
  trip        Trip[]
  kunjungan   Kunjungan[]
  sesi        SesiKonfirmasi[]

  @@map("pengguna")
}

model Perangkat {
  id       Int    @id @default(autoincrement())
  deviceId String @unique

  // kunci publik Ed25519 milik alat, dalam base64
  publicKey String

  petugasId Int?
  petugas   Pengguna? @relation(fields: [petugasId], references: [id])

  calibRefG Int      @default(0)
  lastSeen  DateTime?
  batteryMv Int?
  rssiDbm   Int?

  // ujung rantai bukti milik alat ini
  lastHash String?
  lastSeq  Int     @default(0)

  aktif    Boolean  @default(true)
  dibuatAt DateTime @default(now())

  kejadian    KejadianAlat[]
  penjemputan Penjemputan[]

  @@map("perangkat")
}

// ------------------------------------------------------------
// LAPIS 2 — REFERENSI (berversi waktu)
// ------------------------------------------------------------

model FaktorKategori {
  kategori         String   @id
  intensitasLMinggu Float
  nSampel          Int      @default(0)
  diperbaruiAt     DateTime @updatedAt

  @@map("faktor_kategori")
}

model Harga {
  id          Int      @id @default(autoincrement())
  berlakuDari DateTime
  rpPerKg     Int

  @@index([berlakuDari])
  @@map("harga")
}

// ------------------------------------------------------------
// LAPIS 3 — BUKTI (hanya-tambah)
// ------------------------------------------------------------

model KejadianAlat {
  id Int @id @default(autoincrement())

  perangkatId Int
  perangkat   Perangkat @relation(fields: [perangkatId], references: [id])

  seq     Int
  eventId String        @unique
  type    JenisKejadian

  // waktu menurut ALAT, dan waktu tiba di server — disimpan terpisah
  recordedAt DateTime
  receivedAt DateTime @default(now())

  payload Json

  /// Bita yang BENAR-BENAR ditandatangani alat, disimpan apa adanya.
  /// Tidak boleh disusun ulang dari kolom payload: PostgreSQL JSONB
  /// memotong angka pecahan di 16 digit penting, sehingga koordinat GPS
  /// kehilangan digit terakhirnya dan tanda tangan jadi gagal diverifikasi
  /// padahal datanya tidak diubah siapa pun.
  pesanKanonik String @default("")

  prevHash String?
  hash     String
  sig      String

  terverifikasi Boolean @default(false)
  catatan       String?

  penjemputan Penjemputan?
  tripDropoff Trip?        @relation("DropoffTrip")

  @@unique([perangkatId, seq])
  @@index([type])
  @@index([receivedAt])
  @@map("kejadian_alat")
}

// ------------------------------------------------------------
// LAPIS 4 — TRANSAKSI (diturunkan dari lapis bukti)
// ------------------------------------------------------------

model Trip {
  id        Int      @id @default(autoincrement())
  petugasId Int
  petugas   Pengguna @relation(fields: [petugasId], references: [id])

  tanggal DateTime
  status  StatusTrip @default(BERJALAN)

  titikKumpulId Int?
  titikKumpul   TitikKumpul? @relation(fields: [titikKumpulId], references: [id])

  totalGWarung      Int  @default(0)
  totalGTitikKumpul Int?
  susutG            Int?
  susutPersen       Float?

  dropoffEventId Int?          @unique
  dropoffEvent   KejadianAlat? @relation("DropoffTrip", fields: [dropoffEventId], references: [id])

  penjemputan Penjemputan[]
  lotTrip     LotTrip[]
  kunjungan   Kunjungan[]

  dibuatAt DateTime @default(now())

  @@index([petugasId, tanggal])
  @@map("trip")
}

model Penjemputan {
  id Int @id @default(autoincrement())

  warungId Int
  warung   Warung @relation(fields: [warungId], references: [id])

  petugasId Int
  petugas   Pengguna @relation(fields: [petugasId], references: [id])

  perangkatId Int?
  perangkat   Perangkat? @relation(fields: [perangkatId], references: [id])

  kejadianAlatId Int          @unique
  kejadianAlat   KejadianAlat @relation(fields: [kejadianAlatId], references: [id])

  tripId Int?
  trip   Trip? @relation(fields: [tripId], references: [id])

  beratBersihG Int
  lat          Float
  lon          Float
  gpsAkurasiM  Float?
  jarakDariWarungM Float?

  gpsOk        Boolean @default(false)
  qrOk         Boolean @default(false)

  // Bawaannya TANPA_KODE, bukan sebaliknya: persetujuan pemilik harus
  // dibuktikan, bukan diandaikan.
  caraKonfirmasi CaraKonfirmasi @default(TANPA_KODE)

  /// Terisi hanya ketika `caraKonfirmasi` = TANPA_KODE. Diturunkan dari
  /// muatan yang ditandatangani alat, jadi tidak dapat dikarang setelah
  /// penjemputan tercatat.
  alasanTanpaKode  AlasanTanpaKode?
  catatanTanpaKode String?

  /// USANG — digantikan `caraKonfirmasi`, yang bisa membedakan "pemilik
  /// tidak di tempat" dari "disetujui pemilik".
  ///
  /// Masih ditulis karena basis datanya dipakai bersama versi yang
  /// sudah tayang, dan versi itu masih membaca kolom ini. Dibuang lewat
  /// migrasi tahap kedua setelah versi baru naik.
  konfirmasiOk Boolean @default(false)

  // harga yang berlaku SAAT ITU, bukan sambungan ke harga terkini
  hargaPerKg Int
  nilaiRp    Int

  dibuatAt DateTime @default(now())

  @@index([warungId])
  @@index([tripId])
  @@index([dibuatAt])
  @@map("penjemputan")
}

/// Catatan kunjungan yang TIDAK menghasilkan penjemputan.
/// "Menolak" adalah data yang berharga, jadi alasannya disimpan.
model Kunjungan {
  id       Int            @id @default(autoincrement())
  warungId Int
  warung   Warung         @relation(fields: [warungId], references: [id])
  tripId   Int?
  trip     Trip?          @relation(fields: [tripId], references: [id])
  petugasId Int
  petugas  Pengguna       @relation(fields: [petugasId], references: [id])
  hasil    HasilKunjungan
  catatan  String?
  dibuatAt DateTime       @default(now())

  @@index([warungId])
  @@map("kunjungan")
}

model Lot {
  id            Int         @id @default(autoincrement())
  kode          String      @unique
  titikKumpulId Int
  titikKumpul   TitikKumpul @relation(fields: [titikKumpulId], references: [id])

  beratG Int       @default(0)
  status StatusLot @default(TERBUKA)

  qrToken String @unique

  offtaker     String?
  hargaJual    Int?
  dibuatAt     DateTime  @default(now())
  ditutupAt    DateTime?
  diserahkanAt DateTime?

  trip LotTrip[]

  @@map("lot")
}

model LotTrip {
  lotId  Int
  lot    Lot  @relation(fields: [lotId], references: [id], onDelete: Cascade)
  tripId Int
  trip   Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@id([lotId, tripId])
  @@map("lot_trip")
}

model PermintaanJemput {
  id       Int              @id @default(autoincrement())
  warungId Int
  warung   Warung           @relation(fields: [warungId], references: [id])
  status   StatusPermintaan @default(BARU)
  dibuatAt DateTime         @default(now())

  @@index([status])
  @@map("permintaan_jemput")
}

/// Kode konfirmasi yang sedang menunggu disebutkan pemilik warung.
///
/// Berumur pendek dan sekali pakai. Diterbitkan ketika timbangan sudah
/// stabil, lalu terbaca di dua layar yang berbeda: layar pemilik
/// (/w/[token]) dan — sebagai jendela peraga yang mengaku dirinya
/// jendela peraga — layar petugas.
///
/// Yang membuatnya berarti adalah tempat pembuatannya. Sebelum ini kode
/// dibangkitkan di peramban petugas sendiri, ditampilkan kepada petugas
/// itu juga, dan tidak pernah dicocokkan di mana pun; server hanya
/// memeriksa apakah kolomnya terisi. Kode yang dibuat, disimpan, dan
/// dicocokkan di server barulah membuktikan pemiliknya hadir.
model SesiKonfirmasi {
  id Int @id @default(autoincrement())

  warungId Int
  warung   Warung @relation(fields: [warungId], references: [id])

  petugasId Int
  petugas   Pengguna @relation(fields: [petugasId], references: [id])

  /// Empat angka. Tidak pernah keluar dari server kecuali ke halaman
  /// warung yang bersangkutan.
  kode String

  /// Bobot yang sedang diajukan untuk disetujui, disimpan supaya pemilik
  /// menyetujui angka yang benar-benar dilihatnya — bukan angka yang
  /// baru muncul sesudah ia menyebutkan kodenya.
  beratBersihG Int

  /// Berapa kali kode salah sudah dicoba. Tanpa batas ini, empat angka
  /// bukan pengaman: sepuluh ribu kemungkinan habis dicoba mesin dalam
  /// hitungan menit, dan pihak yang paling mudah melakukannya justru
  /// petugas yang sedang diperiksa.
  percobaan Int @default(0)

  dibuatAt      DateTime  @default(now())
  kedaluwarsaAt DateTime
  dipakaiAt     DateTime?

  @@index([warungId, dipakaiAt])
  @@map("sesi_konfirmasi")
}
